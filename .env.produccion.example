# Copia este archivo como .env en el servidor real (junto a docker-compose.yml)
# y llena cada valor. El .env nunca se sube a Git (está en .gitignore).

# Claves propias de este servidor. Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   -> JWT_SECRETO
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      -> CLAVE_CIFRADO
JWT_SECRETO=
CLAVE_CIFRADO=

# Dirección con la que los usuarios abren la aplicación (va en los enlaces de los correos)
URL_FRONTEND=https://asistencia.ejemplo.edu.co

# IP de cada lector biométrico real, separadas por comas. Solo ellos pueden enviar marcas.
IP_LECTORES=

# Correo (SMTP). Si se deja vacío, los correos no se envían.
CORREO_HOST=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CONTRASENA=
CORREO_REMITENTE="AsistenciaApp SENA <no-responder@sena.edu.co>"
